# Copy to .env (gitignored). Every line is optional: the defaults in compose.yaml work for `just up`.
# IMAGE_TAG=local
# WEB_PORT=8220
# POSTGRES_USER=suwagcms
# POSTGRES_PASSWORD=suwagcms
# POSTGRES_DB=suwagcms
# An external PostgreSQL: set this and start without the db profile (docker compose up -d).
# ConnectionStrings__Default=Host=db.example.internal;Port=5432;Database=suwagcms;Username=suwagcms;Password=change-me
# API_UPSTREAM=http://server:6330
# Rows on a page of every list in the web app: a whole number from 1 to 500; left out, 20. Anything else stops the server at start.
# PAGINATION_PAGE_SIZE=20
# Only for just sdk-publish-local, the fallback of a release (docs/release.md); remove it once that release is out.
# SDK_NUGET_API_KEY=
