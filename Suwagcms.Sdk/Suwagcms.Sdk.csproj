<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <TargetFramework />
    <RootNamespace>Suwagcms.Sdk</RootNamespace>
    <Version>0.0.0-local</Version>
    <PackageId>Suwagcms.Sdk</PackageId>
    <Authors>Piotr Gugnowski</Authors>
    <Copyright>Copyright (c) 2026 Piotr Gugnowski</Copyright>
    <Description>The SDK of a .NET bot built on Suwagcms: the definition format, its validator and the bot runtime that receives, checks and serves the versions the CMS pushes.</Description>
    <PackageTags>suwagcms cms chatbot bot validation aspnetcore</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Manomenu/suwagcms</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Manomenu/suwagcms.git</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="definition-format.schema.json" Pack="true" PackagePath="/" />
    <None Include="bot-runtime.schema.json" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="Suwagcms.Sdk.Tests" />
  </ItemGroup>
</Project>
