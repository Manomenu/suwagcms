<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Bot projects that use the SDK may still be on .NET 9; the repository default is net10. -->
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <TargetFramework />
    <RootNamespace>Suwagcms.Sdk</RootNamespace>
    <!-- A release passes its version (-p:Version=); a local pack is plainly not one. -->
    <Version>0.0.0-local</Version>
    <PackageId>Suwagcms.Sdk</PackageId>
    <Authors>Piotr Gugnowski</Authors>
    <Copyright>Copyright (c) 2026 Piotr Gugnowski</Copyright>
    <Description>The SDK of a .NET bot built on Suwagcms.</Description>
    <PackageTags>suwagcms aspnetcore</PackageTags>
    <!-- An expression, not the LICENSE file: nuget.org shows an SPDX identifier most clearly, and MIT has one. -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Manomenu/suwagcms</PackageProjectUrl>
    <!-- Named here: Source Link would take it from the origin remote, which on a developer's machine is the SSH address. -->
    <RepositoryUrl>https://github.com/Manomenu/suwagcms.git</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
