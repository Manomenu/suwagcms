<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Suwagcms.Gate</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TngTech.ArchUnitNET.xUnitV3" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Suwagcms.Server/Suwagcms.Server.csproj" />
    <ProjectReference Include="../Suwagcms.Cli/Suwagcms.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Suwagcms.Gate.Design" />
    <Using Include="Suwagcms.Gate.Code" />
    <Using Include="Suwagcms.Gate.Repository" />
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Why: the gate tests the fixture's decision without referencing a test project, which the reference rules do not allow -->
  <ItemGroup>
    <Compile Include="../Suwagcms.Server.Tests/LinkedWorktree.cs" Link="Repository/LinkedWorktree.cs" />
  </ItemGroup>
</Project>
