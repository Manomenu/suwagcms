  "components": {
    "schemas": {
      "ArticleView": {
        "required": [
          "id",
          "knowledgeBase",
          "title",
          "content",
          "llmGuide",
          "description",
          "revision"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "knowledgeBase": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "llmGuide": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "revision": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        },
        "description": "An article of a bot as the API shows it: the format's fields, and the revision to send back to guard an edit."
      },
      "Bot": {
        "required": [
          "id",
          "name",
          "address"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          }
        },
        "description": "A registered bot: the id that sits in addresses and commands, the name people see, and where the CMS reaches it."
      },
      "Fact": {
        "required": [
          "name",
          "type",
          "description",
          "writableBy",
          "values",
          "min",
          "max",
          "maxLength",
          "revision"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "writableBy": {
            "type": "string"
          },
          "values": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "min": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "max": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "maxLength": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "revision": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        },
        "description": "A global fact of a bot as the API shows it: the format's fields, and the revision to send back to guard an edit."
      },
      "HealthStatus": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "KnowledgeBaseView": {
        "required": [
          "id",
          "title",
          "revision"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "revision": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        },
        "description": "A knowledge base of a bot as the API shows it: its id and title, and the revision to send back to guard an edit."
      },
      "Mistake": {
        "required": [
          "code",
          "stage",
          "resource",
          "path",
          "message",
          "fix",
          "related"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "stage": {
            "$ref": "#/components/schemas/ValidationStage"
          },
          "resource": {
            "$ref": "#/components/schemas/ResourceRef"
          },
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          },
          "related": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RelatedResource"
            }
          }
        }
      },
      "Refusal": {
        "required": [
          "title",
          "status",
          "detail",
          "mistakes"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": "string"
          },
          "mistakes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Mistake"
            }
          }
        },
        "description": "The Problem Details of a refused change: every mistake at once, each with its fix."
      },
      "RegisterBot": {
        "required": [
          "id",
          "name",
          "address"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
