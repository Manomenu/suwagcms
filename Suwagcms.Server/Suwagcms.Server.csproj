<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Suwagcms.Server</RootNamespace>
    <OpenApiGenerateDocumentsOnBuild>false</OpenApiGenerateDocumentsOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Suwbackkit.Server" />
    <PackageReference Include="Suwbackkit.Postgres" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Suwagcms.Contracts/Suwagcms.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Database/Migrations/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Suwagcms.Gate" />
    <InternalsVisibleTo Include="Suwagcms.Server.Tests" />
  </ItemGroup>
</Project>
